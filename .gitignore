# ============================================
# Unity .gitignore
# ============================================

# OS / Editor
.DS_Store
Thumbs.db
Desktop.ini

# Unity Generated
Library/
Temp/
Obj/
Logs/
MemoryCaptures/
Artifacts/

# Build results
Build/
Builds/
ExportedObj/
Debug/
Release/
bin/
obj/

# Packages cache
UnityPackageManager/
UserSettings/

# Crash and error logs
sysinfo.txt

# Auto-generated VS/JetBrains files
*.csproj
*.pidb
*.suo
*.sln
*.user
*.unityproj
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Rider / JetBrains
.idea/
*.iml

# Visual Studio
.vs/

# Unity Collaborate
.collab/

# Addressables
Assets/AddressableAssetsData/*/*.bin*
Assets/StreamingAssets/aa/

# TextMesh Pro
Assets/TextMesh Pro/*/*.asset

# Generated Animation stuff
*.anim.meta

# Builds
*.apk
*.aab
*.ipa
*.exe

# Crash Dumps
*.dmp

# Recordings
*.mp4
*.mov
*.webm

# Meta Quest / XR Plugins temporary
Assets/XR/Loaders/Meta/*Generated*/

# Autogenerated XR Mock Data
XR/MockHMD/*Generated*/


# ============================================
# Allowed (Keep These!)
# ============================================
!Assets/
!ProjectSettings/
!Packages/

# Firebase native binaries
Assets/Firebase/Plugins/x86_64/

# Oculus Sample Avatars (should not be committed)
Assets/Oculus/Avatar2_SampleAssets/
